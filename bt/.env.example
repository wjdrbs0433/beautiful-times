# Public configuration for the current account cloud sync integration.
# Only public project configuration belongs in EXPO_PUBLIC_ values.
# Never put Supabase service_role/secret or Kakao client secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public JavaScript SDK identifier; visible in client bundles by design.
EXPO_PUBLIC_KAKAO_JS_KEY=
# Development defaults; production must use HTTPS backend and map origin.
EXPO_PUBLIC_ROUTE_BASE_URL=http://127.0.0.1:8090
EXPO_PUBLIC_MAP_BASE_URL=http://127.0.0.1:8081
